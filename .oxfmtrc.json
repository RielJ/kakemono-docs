{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": true,
	"printWidth": 120,
	"overrides": [
		{
			"files": ["*.css", "*.html"],
			"options": {
				"singleQuote": false
			}
		}
	],
	"ignorePatterns": ["dist/**", ".astro/**", ".vercel/**", ".pi/**", "bun.lock", "**/*.md", "**/*.mdx"]
}
