---
import '@fontsource-variable/inter/wght.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/ibm-plex-mono/latin-600.css';
import '../styles/tokens.css';
import Showcase from '../components/Showcase.astro';
import Shot from '../components/Shot.astro';
import InstallCards from '../components/install/InstallCards.astro';
import wordmarkDark from '../assets/kakemono-wordmark-dark.png';
import wordmarkLight from '../assets/kakemono-wordmark-light.png';

const title = 'kakemono: free wallpaper manager app for Mac, Windows and Linux';
const description =
	'kakemono is a free wallpaper manager for Mac, Windows and Linux. It finds wallpapers on Wallhaven, Unsplash, Reddit, Bing, NASA or any web page, or in your own folders, and changes your desktop on a timer.';
const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://kakemono.rielj.xyz';
// Tells search engines this page is about an app (name, systems, price), so results can show it as one.
const softwareApp = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'kakemono',
	applicationCategory: 'DesktopEnhancementApplication',
	operatingSystem: 'macOS, Windows, Linux',
	description,
	url: `${site}/`,
	image: `${site}/og.png`,
	downloadUrl: `${site}/install/`,
	license: 'https://github.com/RielJ/kakemono/blob/main/LICENSE',
	isAccessibleForFree: true,
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
	author: { '@type': 'Person', name: 'Riel Joseph C. Bulaybulay', url: 'https://rielj.xyz' },
	sameAs: ['https://github.com/RielJ/kakemono', 'https://aur.archlinux.org/packages/kakemono-bin'],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="canonical" href={`${site}/`} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`${site}/`} />
		<meta property="og:image" content={`${site}/og.png`} />
		<meta property="og:image:width" content="1280" />
		<meta property="og:image:height" content="640" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={`${site}/og.png`} />
		<script type="application/ld+json" set:html={JSON.stringify(softwareApp)} />
		<!-- Same theme choice as the docs (Starlight stores it), else the system's. Runs before paint. -->
		<script is:inline>
			(() => {
				const stored = localStorage.getItem('starlight-theme');
				const theme =
					stored === 'light' || stored === 'dark'
						? stored
						: matchMedia('(prefers-color-scheme: light)').matches
							? 'light'
							: 'dark';
				document.documentElement.dataset.theme = theme;
			})();
		</script>
	</head>
	<body>
		<!-- Clips the full-width rule lines, so they don't widen the page. -->
		<div class="page">
		<header class="top">
			<a class="brand" href="/">
				<img class="only-dark" src={wordmarkDark.src} alt="kakemono" width={wordmarkDark.width / 3} height="32" />
				<img class="only-light" src={wordmarkLight.src} alt="kakemono" width={wordmarkLight.width / 3} height="32" />
			</a>
			<nav aria-label="Main">
				<a href="/install/">Install</a>
				<a href="/using/">How to use</a>
				<a class="icon" href="https://github.com/RielJ/kakemono" aria-label="kakemono on GitHub">
					<svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true" fill="currentColor">
						<path
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
						></path>
					</svg>
				</a>
				<button class="icon" type="button" data-theme-toggle aria-label="Switch to light theme">
					<svg class="sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
						<circle cx="12" cy="12" r="4"></circle>
						<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
					</svg>
					<svg class="moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
						<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
					</svg>
				</button>
			</nav>
		</header>

		<div class="frame">
			<main>
				<section class="hero">
					<p class="kk-eyebrow ruled">Wallpaper manager for Mac, Windows and Linux</p>
					<h1 class="ruled">A new wallpaper whenever you want one.</h1>
					<p class="lede ruled">
						kakemono is a small, free wallpaper manager. It finds wallpapers on Wallhaven, Unsplash, Reddit, Bing and NASA, or in your own
						folders, and puts them on your desktop.
					</p>
					<div class="actions ruled">
						<a class="button" href="#download">
							<svg
								class="button-icon"
								viewBox="0 0 20 20"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="M3.5 13v2.5a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1V13" />
								<g class="button-arrow">
									<path d="M10 3v9.5M6 8.5l4 4 4-4" />
								</g>
							</svg>
							Download
						</a>
						<p class="actions-note">Free for macOS, Windows and Linux</p>
					</div>
				</section>

				<section class="demo ruled kk-hatch" aria-label="Try the picker">
					<Showcase />
				</section>

				<section class="split">
					<div class="split__text">
						<p class="kk-eyebrow ruled">How it works</p>
						<h2 class="ruled">Set it up once, then forget it.</h2>
						<ol class="steps">
							<li>
								<span class="num" aria-hidden="true">01</span>
								<div>
									<h3>It lives in your menu bar</h3>
									<p>On Windows and Linux it sits in the system tray. There's no window to keep open.</p>
								</div>
							</li>
							<li>
								<span class="num" aria-hidden="true">02</span>
								<div>
									<h3>Choose where pictures come from</h3>
									<p>
										Wallhaven and a Favorites folder are set up for you. You can add Unsplash, Reddit, Bing, NASA's picture of the
										day, a web page or a folder on your computer.
									</p>
								</div>
							</li>
							<li>
								<span class="num" aria-hidden="true">03</span>
								<div>
									<h3>Change it when you like</h3>
									<p>
										Click Next in the menu, pick one from the strip, or let kakemono change it every 30 minutes. Until you ask, it
										leaves your wallpaper alone.
									</p>
								</div>
							</li>
						</ol>
					</div>
					<div class="split__media kk-hatch">
						<Shot
							name="welcome-3"
							alt="The kakemono Welcome window, on the Set it up screen"
							caption="The Welcome window, the first time you open kakemono."
							width={520}
						/>
					</div>
				</section>

				<section class="split split--flip">
					<div class="split__text">
						<p class="kk-eyebrow ruled">Settings</p>
						<h2 class="ruled">Every option is a checkbox.</h2>
						<p class="body">
							Go back to an earlier wallpaper, keep the ones you like in Favorites, and get a new picture when your computer
							switches between light and dark mode.
						</p>
						<p class="body"><a href="/using/">Read how to use kakemono</a></p>
					</div>
					<div class="split__media kk-hatch">
						<Shot name="settings" alt="kakemono Settings, General tab" cut width={520} />
					</div>
				</section>

				<section class="get" id="download">
					<p class="kk-eyebrow ruled">Download</p>
					<h2 class="ruled">Get kakemono.</h2>
					<div class="get-cards ruled">
						<InstallCards />
					</div>
					<p class="body after-cells">
						Each card opens a page with the steps. The app isn't signed yet, so your system warns you the first time you open
						it, and each page shows what to click.
					</p>
				</section>
			</main>

			<footer class="foot ruled">
				<p>
					kakemono is free and open source under the MIT licence. Made by <a
						href="https://rielj.xyz/blog/building-kakemono-cross-platform-wallpaper-manager">Riel Joseph Bulaybulay</a
					>. Source on <a href="https://github.com/RielJ/kakemono">GitHub</a>.
				</p>
				<p>The demo photos are CC0, published on Unsplash by their photographers and mirrored on Wikimedia Commons.</p>
			</footer>
		</div>
		</div>

		<script>
			// Theme toggle. Stored under Starlight's key, so the docs open in the same theme.
			const root = document.documentElement;
			const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
			const label = () => {
				if (toggle) toggle.ariaLabel = `Switch to ${root.dataset.theme === 'light' ? 'dark' : 'light'} theme`;
			};
			label();
			toggle?.addEventListener('click', () => {
				const next = root.dataset.theme === 'light' ? 'dark' : 'light';
				root.dataset.theme = next;
				localStorage.setItem('starlight-theme', next);
				label();
			});
			// Follow the system while the visitor hasn't picked a theme.
			matchMedia('(prefers-color-scheme: light)').addEventListener('change', (e) => {
				const stored = localStorage.getItem('starlight-theme');
				if (stored === 'light' || stored === 'dark') return;
				root.dataset.theme = e.matches ? 'light' : 'dark';
				label();
			});
		</script>
	</body>
</html>

<style is:global>
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		background: var(--kk-bg);
		color: var(--kk-text);
		font: 400 1rem/1.75 var(--kk-font-body);
	}

	h1,
	h2,
	h3 {
		margin: 0;
		color: var(--kk-strong);
		text-wrap: balance;
	}

	p {
		margin: 0;
	}

	a {
		color: var(--kk-strong);
		font-weight: 600;
		text-decoration: underline 1px var(--kk-underline);
		text-underline-offset: 3px;
	}

	a:hover {
		text-decoration-thickness: 2px;
	}

	.page {
		overflow-x: clip;
	}

	/* The hero's Download button jumps to the download cards. Leave room for the sticky header. */
	#download {
		scroll-margin-top: 3.5rem;
	}

	@media (prefers-reduced-motion: no-preference) {
		:global(html) {
			scroll-behavior: smooth;
		}
	}

	/* Header: full width, a hairline under it, translucent so the page shows through on scroll. */
	.top {
		position: sticky;
		top: 0;
		z-index: 10;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 16px;
		height: 3.5rem;
		padding-inline: clamp(1rem, 2vw, 1.5rem);
		border-bottom: 1px solid var(--kk-line);
		background: color-mix(in srgb, var(--kk-bg) 88%, transparent);
		backdrop-filter: blur(8px);
	}

	.brand {
		display: inline-flex;
		align-items: center;
	}

	.brand img {
		height: 32px;
		width: auto;
	}

	.top nav {
		display: flex;
		align-items: center;
		gap: clamp(14px, 2vw, 24px);
	}

	.top nav a {
		font-size: 0.875rem;
		font-weight: 500;
		text-decoration: none;
	}

	.top nav a:hover {
		color: var(--kk-muted);
	}

	.icon {
		display: inline-grid;
		place-items: center;
		padding: 0;
		border: 0;
		background: none;
		color: var(--kk-muted);
		cursor: pointer;
		transition: color 120ms ease;
	}

	.top nav .icon:hover,
	.icon:hover {
		color: var(--kk-strong);
	}

	:root[data-theme='light'] .icon .sun,
	:root:not([data-theme='light']) .icon .moon {
		display: none;
	}

	/* The page column: bordered left and right, with hatched gutters outside it. */
	.frame {
		position: relative;
		width: min(100% - 5rem, 80rem);
		margin-inline: auto;
		border-inline: 1px solid var(--kk-line);
	}

	.frame::before,
	.frame::after {
		content: '';
		position: absolute;
		inset-block: 0;
		width: 2.5rem;
		background-image: repeating-linear-gradient(315deg, var(--kk-hatch) 0 1px, transparent 0 50%);
		background-size: 10px 10px;
	}

	.frame::before {
		right: 100%;
		border-inline-start: 1px solid var(--kk-line);
	}

	.frame::after {
		left: 100%;
		border-inline-end: 1px solid var(--kk-line);
	}

	/* A row with a hairline above and below that runs the full width of the window. */
	.ruled {
		position: relative;
	}

	.ruled::before,
	.ruled::after {
		content: '';
		position: absolute;
		left: -100vw;
		right: -100vw;
		height: 1px;
		background: var(--kk-line);
		pointer-events: none;
	}

	.ruled::before {
		top: 0;
	}

	.ruled::after {
		bottom: 0;
	}

	main > section {
		padding-top: clamp(4rem, 9vw, 7rem);
	}

	/* Hero */
	.hero > * {
		padding-inline: 0.5rem;
	}

	.hero .kk-eyebrow {
		padding-block: 0.25rem;
	}

	.hero h1 {
		margin-top: 1rem;
		font-size: clamp(2.75rem, 7.5vw, 6rem);
		font-weight: 400;
		line-height: 1;
		letter-spacing: -0.05em;
		padding-block: 0.25rem 0.5rem;
	}

	/* The rules run full width; the text itself stops at 44rem. */
	.lede {
		margin-top: 2rem;
		padding-right: max(0.5rem, 100% - 44rem);
		font-size: 1.125rem;
		font-weight: 500;
		line-height: 1.75rem;
		color: var(--kk-text);
		text-wrap: pretty;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1rem;
		margin-top: 2.5rem;
	}

	/* The one call to action on the page: brand colour, larger than body text. */
	.button {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		height: 3rem;
		padding-inline: 1.25rem 1.5rem;
		border-radius: 999px;
		background: var(--kk-cta-bg);
		color: var(--kk-cta-text);
		font-size: 1rem;
		font-weight: 600;
		text-decoration: none;
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.2),
			0 6px 20px -8px var(--kk-cta-glow);
		transition:
			background-color 150ms ease,
			box-shadow 200ms ease,
			transform 150ms var(--kk-ease-out);
	}

	.button-icon {
		flex: none;
		width: 1.25rem;
		height: 1.25rem;
		overflow: hidden;
	}

	/* After the page settles, the arrow drops into the tray twice to draw the eye. */
	.button-arrow {
		animation: kk-arrow-nudge 1.1s var(--kk-ease-out) 1.2s 2;
	}

	@keyframes kk-arrow-nudge {
		0%,
		60%,
		100% {
			transform: translateY(0);
		}
		30% {
			transform: translateY(3px);
		}
	}

	/* On hover the arrow keeps falling into the tray: out at the bottom, back in from the top. */
	@keyframes kk-arrow-drop {
		0% {
			transform: translateY(0);
			opacity: 1;
		}
		45% {
			transform: translateY(9px);
			opacity: 0;
		}
		46% {
			transform: translateY(-9px);
			opacity: 0;
		}
		100% {
			transform: translateY(0);
			opacity: 1;
		}
	}

	@media (hover: hover) {
		.button:hover {
			background: var(--kk-cta-hover);
			box-shadow:
				inset 0 1px 0 rgb(255 255 255 / 0.2),
				0 10px 28px -8px var(--kk-cta-glow);
		}

		.button:hover .button-arrow {
			animation: kk-arrow-drop 900ms var(--kk-ease-out) infinite;
		}
	}

	.button:focus-visible .button-arrow {
		animation: kk-arrow-drop 900ms var(--kk-ease-out) infinite;
	}

	.button:active {
		transform: scale(0.97);
	}

	.actions-note {
		margin: 0;
		font-size: 0.875rem;
		color: var(--kk-muted);
	}

	/* Demo: the showcase on a hatched band. */
	.demo {
		margin-top: clamp(3rem, 6vw, 4.5rem);
		padding: clamp(0.5rem, 2vw, 2rem) clamp(0.5rem, 2vw, 2rem) 1rem;
	}

	main > section.demo {
		padding-top: clamp(0.5rem, 2vw, 2rem);
	}

	/* Two columns: text on one side, a hatched panel with a screenshot on the other. */
	.split {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		align-items: stretch;
	}

	.split__text {
		padding: 0 clamp(0.5rem, 3vw, 2.5rem) 2rem 0.5rem;
	}

	.split h2,
	.get h2 {
		margin-top: 0.75rem;
		padding-block: 0.25rem;
		font-size: clamp(1.875rem, 3.6vw, 2.5rem);
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: -0.025em;
	}

	.kk-eyebrow.ruled {
		padding-block: 0.25rem;
	}

	.body {
		margin-top: 1.5rem;
		max-width: 34rem;
	}

	.split__media {
		display: grid;
		place-items: center;
		padding: clamp(1rem, 3vw, 2.5rem);
		border-inline-start: 1px solid var(--kk-line);
		border-block: 1px solid var(--kk-line);
	}

	.split--flip .split__text {
		order: 2;
		padding: 0 0.5rem 2rem clamp(0.5rem, 3vw, 2.5rem);
	}

	.split--flip .split__media {
		border-inline-start: 0;
		border-inline-end: 1px solid var(--kk-line);
	}

	/* Numbered steps, boxed like the Tailwind install guide. */
	.steps {
		display: grid;
		gap: 1.75rem;
		margin: 2rem 0 0;
		padding: 0;
		list-style: none;
	}

	.steps li {
		display: grid;
		grid-template-columns: 1.75rem minmax(0, 1fr);
		gap: 1.25rem;
	}

	.num {
		display: grid;
		place-items: center;
		width: 1.75rem;
		height: 1.75rem;
		border: 1px solid color-mix(in srgb, var(--kk-strong) 45%, transparent);
		font: 500 0.625rem/1 var(--kk-font-mono);
		letter-spacing: 0.1em;
		color: var(--kk-strong);
	}

	.steps h3 {
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.75rem;
	}

	.steps p {
		margin-top: 0.25rem;
	}

	/* Screenshots outside Starlight: same frame as in the docs. */
	.shot {
		margin: 0;
		width: 100%;
	}

	.shot__frame {
		padding: 0.5rem;
		border-radius: 1rem;
		background: var(--kk-bg);
		box-shadow: var(--kk-ring);
	}

	.shot__frame img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.5rem;
		box-shadow: 0 0 0 1px var(--kk-line);
	}

	.shot figcaption {
		margin-top: 0.75rem;
		font-size: 0.8125rem;
		color: var(--kk-muted);
	}

	.shot--cut img {
		mask-image: linear-gradient(to bottom, #000 78%, transparent);
	}

	:root[data-theme='light'] .only-dark,
	:root:not([data-theme='light']) .only-light {
		display: none;
	}

	/* Downloads: the same cards as the Install page, between two hairlines. */
	.get > :not(.get-cards) {
		padding-inline: 0.5rem;
	}

	.get-cards {
		margin-top: 2.5rem;
		padding: 0.25rem 0.75rem 1.5rem;
	}

	/* Nine cards: three columns fill a 3×3 grid on wide screens. */
	@media (min-width: 64rem) {
		.get-cards .kk-cards {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	.after-cells {
		margin-top: 1.5rem;
		max-width: 44rem;
		font-size: 0.9375rem;
		color: var(--kk-muted);
	}

	.foot {
		margin-top: clamp(4rem, 9vw, 7rem);
		padding: 1.5rem 0.5rem 2rem;
		font-size: 0.8125rem;
		line-height: 1.5rem;
		color: var(--kk-muted);
